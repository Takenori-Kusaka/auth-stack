{
  "id": "CV-062",
  "title": "AI エージェントによる代理（act.ptype=ai_agent）の tool 側 PEP の負例",
  "source": [
    "13_integration-trial/room-booking/report.md C-2・L-13",
    "CON-18（11_contracts/agent-delegation.openapi.yaml、v1.2 新設、preview）AD-01〜AD-10・AGN-12〜AGN-23・AGN-25",
    "INT-02 P-08 NP08-4・NP08-7",
    "ADR-017 §2.2〜§2.4・§2.6"
  ],
  "roles": [
    {
      "role": "CR-1",
      "applies_when": "manifest に agent_delegation（CON-18 AgentToolDeclaration）を宣言した entry point がある"
    }
  ],
  "status": "preview",
  "distinguish_from": [
    {
      "id": "CV-036",
      "how": "CV-036〜CV-038 は第一者のエージェント製品の実行単位・SVID・鍵の束縛（D17-07 (a)(b)）。本ベクタは edge の後ろの tool 側 PEP が K3 の act・scope・承認 grant で行う判定（CON-18 AD-01〜AD-10）"
    }
  ],
  "stub_requirements": [
    "ST-1 で act={sub, ptype: ai_agent}・client_id（委任用 client）・scope を入れた K3 を鋳造できる（CON-18 §9 HO12-AG-07 (c)、CON-16 ST-1 v1.2）",
    "承認 grant の消費（CON-18 consumeApprovalGrant）のスタブ（ST-9 案）が、成功・already_consumed・approval_mismatch・unavailable を試験から切り替えられる",
    "entry point 台帳に agent_delegation を宣言した entry point（manifest.operation.agent_write・agent_approval）と、宣言していない entry point（manifest.operation.write）がある"
  ],
  "cases": [
    {
      "case_id": "CV-062a",
      "description": "AGN-14 / AD-02: sub 自体の ptype が ai_agent の K3（自律動作）で、代理を宣言した entry point を呼ぶ",
      "stimulus": {
        "setup": [
          {
            "op": "fixtures",
            "txn_token": {
              "signer": "TTS.current",
              "claims": {
                "sub": "{{subject.self}}",
                "tctx": {
                  "tid": "{{tenant.1}}",
                  "tier": "write"
                }
              }
            },
            "present_txn_token_as": "txn_token_header",
            "note": "write 以上は正規の Txn-Token を添える（CV-012 と同じ）"
          }
        ],
        "mint": {
          "base": "access_token",
          "claimed_issuer": "A",
          "signer": "A.current",
          "claims": {
            "sub": "{{agent.sub}}",
            "ptype": "ai_agent",
            "client_id": "{{agent.autonomous_client}}",
            "tid": "{{tenant.1}}"
          }
        },
        "present": {
          "as": "authorization_bearer"
        },
        "request": {
          "operation": "{{manifest.operation.agent_write}}",
          "tier": "write",
          "resource": "{{resource.t1.own}}"
        }
      },
      "expect": {
        "outcome": "reject",
        "side_effects": {
          "business_execution": 0,
          "pdp_calls_max": 0,
          "tool_executions_max": 0
        },
        "notes": "PDP を呼ばずに拒否（ADR-017 K17-1 未決、INT-02 SM-3）。E2 の no_decision_cause は CON-08 の値の追加（CON-11 §14.5 H12-4）まで CON-16 §2.8 v1.2 の暫定に従う"
      }
    },
