{
  "id": "CV-012",
  "title": "PDP の timeout・deny・失効（MK-03 の注入）",
  "source": [
    "ADR-022 D-6-2 (12)",
    "CON-03 §7",
    "ADR-013 D13-23",
    "ADR-013 RR13-13",
    "ARC-06 §3.6",
    "ARC-06 TC-06-07"
  ],
  "roles": [
    {
      "role": "CR-1"
    },
    {
      "role": "CR-2"
    }
  ],
  "status": "required",
  "stub_requirements": [
    "PDP スタブは注入ごとに応答を変えられる（CON-11 §4.4 の表）",
    "接続確立の遅延は TCP の accept を遅らせる中継で作る（応答の遅延では代用しない）",
    "SUT 側の計時（接続確立・TLS 完了・ヘッダ受信・本文受信）を記録する",
    "SUT の D(t) は fail-mode 設定文書（CON-11 §11.6）から読ませ、スタブの遅延は D(t) を超える値にする"
  ],
  "cases": [
    {
      "case_id": "CV-012a",
      "description": "MK-03 の注入「応答しない」。write と read-sensitive の操作の両方で流す（ケース内の request は write。read-sensitive は同じ注入で request.tier を read-sensitive に替えて流す）",
      "stimulus": {
        "inject": {
          "target": "MK-03",
          "kind": "timeout"
        },
        "mint": {
          "base": "access_token",
          "claimed_issuer": "A",
          "signer": "A.current"
        },
        "present": {
          "as": "authorization_bearer"
        },
        "request": {
          "operation": "{{manifest.operation.write}}",
          "tier": "write",
          "resource": "{{resource.t1.own}}"
        }
      },
      "expect": {
        "outcome": "no_decision",
        "response_profile": "no_decision",
        "side_effects": {
          "business_execution": 0,
          "allow_used_after_deadline": 0,
          "write_allow_during_injection": 0
        }
      }
    },
