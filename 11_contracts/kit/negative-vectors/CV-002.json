{
  "id": "CV-002",
  "title": "typ の取違え",
  "source": [
    "ADR-022 D-6-2 (2)",
    "ARC-02 NV-16〜NV-19",
    "ARC-02 NV-57",
    "CON-06 NE-01"
  ],
  "roles": [
    {
      "role": "CR-1"
    }
  ],
  "status": "required",
  "stub_requirements": [
    "issuer A（本番役）の discovery と JWKS を、SUT の AUTH_OIDC_DISCOVERY_URL が指す 1 つの origin で配る",
    "token を自前の鍵で鋳造できる（ES256、kid 付き）。header と claim を個別に上書きできる",
    "スタブへの取得（discovery・JWKS）の記録を残す（stub_access_log）",
    "Txn-Token・SET・ID Token の形の JWT を、issuer A の鍵で署名して作れる（署名は正規、typ だけが違う形）"
  ],
  "cases": [
    {
      "case_id": "CV-002a",
      "description": "typ=txntoken+jwt",
      "stimulus": {
        "mint": {
          "base": "access_token",
          "claimed_issuer": "A",
          "signer": "A.current",
          "header": {
            "typ": "txntoken+jwt"
          }
        },
        "present": {
          "as": "authorization_bearer"
        },
        "request": {
          "operation": "{{manifest.operation.read}}",
          "tier": "read-sensitive",
          "resource": "{{resource.t1.own}}"
        }
      },
      "expect": {
        "outcome": "reject",
        "response_profile": "auth_failure",
        "same_as_group": "token_reject",
        "side_effects": {
          "business_execution": 0,
          "pdp_calls_max": 0
        }
      }
    },
    {
      "case_id": "CV-002b",
      "description": "typ=secevent+jwt",
      "stimulus": {
        "mint": {
          "base": "access_token",
          "claimed_issuer": "A",
          "signer": "A.current",
          "header": {
            "typ": "secevent+jwt"
