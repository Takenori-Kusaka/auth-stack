{
  "$comment": "TC-003 BOLA / function-level / property-level negative vectors — parameters fixed BEFORE the first measurement run (test plan §2.2 F-3(b)). TC-003 is '可' in §3.4: pass = 受理 0 件 and 許されない属性の返却 0 件 (§4.3). Enumerated, deterministic vectors (§2.7: one acceptance fails the TC).",
  "tc": "TC-003",
  "version": "1.0.0",
  "plan_section": "§4.3",
  "engines": ["openfga", "cedar"],
  "dataset": { "generator": "data/gen-synthetic.js", "profile": "small", "seed": 4003 },
  "settings": { "accessTokenTtlSec": 20 },
  "expired_wait_ms": 23000,
  "amr": "pwd,fido",
  "ledger_file": "config/ledger.json",
  "service_sources": ["services/file-service.js", "services/tool-service.js", "services/label-service.js"],
  "methods_probed": ["GET", "POST", "PUT", "PATCH", "DELETE"],
  "method_override_headers": [["x-http-method-override", "DELETE"], ["x-method-override", "DELETE"], ["x-http-method", "DELETE"]],
  "method_override_query": "_method=DELETE",
  "mass_assignment_fields": { "owner": "<stranger>", "tid": "<other tenant>", "folder": "<other folder>", "version": 999, "id": "synforcedid0000000000000000", "ctoken": "forged", "labels": ["PUBLIC"], "relation": "owner", "role": "owner", "project": "synforcedproj00000000000000", "acl": ["*"] },
  "allowed_response_properties": {
    "$comment": "The reference services have no response schema in 11_contracts; the allow-list is the documented view of each entry point (README §2 / service code view functions, fixed here before measurement). Anything else in a 2xx body (notably owner, tid, ctoken, other subjects' identifiers) is a 許されない属性.",
    "file.read": ["id", "folder", "content", "version", "decision_id", "labels", "label_decision_id"],
    "file.write": ["id", "folder", "content", "version"],
    "file.delete": [],
    "file.create": ["id", "folder", "content", "version"],
    "file.share": ["shared"],
    "file.move": ["id", "folder", "content", "version"],
    "file.signed_url": ["url", "expires_in"],
    "file.download": ["id", "folder", "content", "version"],
    "folder.list": ["items", "completeness", "items[].id", "items[].folder", "items[].content", "items[].version", "completeness.status", "completeness.reason"],
    "file.search": ["items", "next_cursor", "completeness", "items[].id", "completeness.status", "completeness.reason"],
    "tool.view": ["id", "project"],
    "tool.run": ["tool", "input", "result", "result.length", "result.sha256", "decision_id", "downstream_decision_id", "labels", "label_decision_id"],
    "tool.config": ["id", "config", "config.*"],
    "label.read": ["id", "labels", "decision_id"]
  },
  "forbidden_value_rule": "a 2xx body must not contain the owner tenant id, the owner's subject id or any other user's subject id (values), regardless of the property name",
  "abort": { "positive_control_failure_max": 0, "ledger_operation_count_must_match": true }
}
