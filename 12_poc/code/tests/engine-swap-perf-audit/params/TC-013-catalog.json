    "c.time_window": { "expression": "current_time >= window_start && current_time < window_end", "parameters": { "current_time": "timestamp", "window_start": "timestamp", "window_end": "timestamp" }, "request_context": ["current_time"] },
    "c.device_managed": { "expression": "device_managed == true", "parameters": { "device_managed": "bool" }, "request_context": ["device_managed"] },
    "c.min_acr": { "expression": "acr_rank >= min_rank", "parameters": { "acr_rank": "int", "min_rank": "int" }, "request_context": ["acr_rank"] },
    "c.purpose_in": { "expression": "purpose == allowed_purpose", "parameters": { "purpose": "string", "allowed_purpose": "string" }, "request_context": ["purpose"] }
  },
